# Resend - recomendado para Vercel (sin branding, correo personalizado)
# Crea cuenta en https://resend.com y obtén tu API key
RESEND_API_KEY=re_xxxxxxxxxxxx
# Opcional: usa tu dominio verificado (ej: PlanB FX <noreply@planb-fx.com>)
# RESEND_FROM=PlanB FX <onboarding@resend.dev>
# RESEND_TO=info@planb-fx.com

# Alternativa: SMTP (solo si despliegas en VPS/Railway, NO funciona en Vercel)
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=587
# SMTP_USER=info@planb-fx.com
# SMTP_PASS=tu_contraseña
# SMTP_TO=info@planb-fx.com
